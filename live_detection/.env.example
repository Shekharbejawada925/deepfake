HOST=127.0.0.1
PORT=5000
MODEL_PATH=models/legacy_detector.pt
DEVICE=auto
MAX_UPLOAD_MB=100
MAX_VIDEO_SECONDS=300
MAX_STREAM_SECONDS=600
MAX_JOBS=2
RETENTION_SECONDS=3600
# Exact, operator-approved hostnames or IP addresses, separated by commas.
# Redirects / HLS subresources are handled by FFmpeg; use trusted sources only.
STREAM_ALLOWED_HOSTS=
# Set a unique random secret if sessions must survive restarts.
SECRET_KEY=
# Set 1 behind HTTPS; localhost HTTP needs 0.
COOKIE_SECURE=0
